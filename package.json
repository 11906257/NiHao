{
  "name": "nihao",
  "version": "1.0.0",
  "description": "Private Offline-Lernapp für HSK 3.0 Level 1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate-curriculum.ts",
    "test": "vitest run",
    "build": "npm run typecheck && npm run validate && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
